APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Hora de pared que se graba en las columnas `timestamp` (sin zona). Debe ir a la
# par de DB_TIMEZONE: si difieren, unas fechas quedan en un huso y otras en otro.
APP_TIMEZONE=America/Santiago

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=utamed
DB_USERNAME=utamed
DB_PASSWORD=utamed_dev_password
# Huso de la conexión: manda sobre el DEFAULT now() de las columnas de fecha.
DB_TIMEZONE=America/Santiago

# Oracle legacy/external database connection
ORACLE_DB_HOST=oracle.example.com
ORACLE_DB_PORT=1521
ORACLE_DB_DATABASE=UTAMED
ORACLE_DB_USERNAME=system_user
ORACLE_DB_PASSWORD=change_me
ORACLE_DB_SERVICE_NAME=ORCL

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# =============================================================================
# FILE STORAGE & VALIDATION CONFIGURATION
# =============================================================================

FILES_DEFAULT_TYPE=document
FILES_MAX_FILE_SIZE=52428800
FILES_ENABLE_MIME_VALIDATION=true
FILES_ENABLE_EXTENSION_VALIDATION=true

# Video files
FILES_VIDEO_EXTENSIONS=mp4,webm,avi,mov,mkv,flv,wmv,m4v
FILES_VIDEO_MIMES=video/mp4,video/webm,video/x-msvideo,video/quicktime,video/x-matroska,video/x-flv,video/x-ms-wmv,video/x-m4v
FILES_VIDEO_MAX_SIZE=524288000

# Image files (raster & vector)
FILES_IMAGE_EXTENSIONS=png,jpg,jpeg,webp,gif,bmp,svg,tiff
FILES_IMAGE_MIMES=image/png,image/jpeg,image/webp,image/gif,image/bmp,image/svg+xml,image/tiff
FILES_IMAGE_MAX_SIZE=52428800

# Compressed files
FILES_COMPRESSED_EXTENSIONS=zip,rar,7z,tar,gz,bz2,tar.gz,tar.bz2
FILES_COMPRESSED_MIMES=application/zip,application/x-rar-compressed,application/x-7z-compressed,application/x-tar,application/gzip,application/x-bzip2
FILES_COMPRESSED_MAX_SIZE=524288000

# Word documents (DOCX, DOC, RTF, ODT)
FILES_WORD_DOCUMENT_EXTENSIONS=doc,docx,docm,dot,dotx,dotm,rtf,odt,txt
FILES_WORD_DOCUMENT_MIMES=application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-word.document.macroenabled.12,application/vnd.openxmlformats-officedocument.wordprocessingml.template,application/rtf,application/vnd.oasis.opendocument.text,text/plain
FILES_WORD_DOCUMENT_MAX_SIZE=52428800

# Presentations (PPTX, PPT, ODP, Keynote)
FILES_PRESENTATION_EXTENSIONS=ppt,pptx,pptm,pot,potx,potm,odp,key
FILES_PRESENTATION_MIMES=application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/vnd.ms-powerpoint.presentation.macroenabled.12,application/vnd.openxmlformats-officedocument.presentationml.slidemaster,application/vnd.oasis.opendocument.presentation,application/vnd.apple.keynote
FILES_PRESENTATION_MAX_SIZE=104857600

# Spreadsheets (XLSX, XLS, ODS, Numbers)
FILES_SPREADSHEET_EXTENSIONS=xls,xlsx,xlsm,xlt,xltx,xltm,ods,numbers,csv,tsv
FILES_SPREADSHEET_MIMES=application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel.sheet.macroenabled.12,application/vnd.openxmlformats-officedocument.spreadsheetml.template,application/vnd.oasis.opendocument.spreadsheet,application/vnd.apple.numbers,text/csv,text/tab-separated-values
FILES_SPREADSHEET_MAX_SIZE=52428800

# PDF documents
FILES_PDF_EXTENSIONS=pdf
FILES_PDF_MIMES=application/pdf
FILES_PDF_MAX_SIZE=104857600

# Media files (superset: video, image, audio)
FILES_MEDIA_EXTENSIONS=mp4,webm,avi,mov,mkv,flv,wmv,m4v,mp3,wav,flac,aac,ogg,wma,png,jpg,jpeg,webp,gif,bmp,svg,tiff,psd,ai,raw,cr2,nef,arw
FILES_MEDIA_MIMES=video/mp4,video/webm,video/x-msvideo,video/quicktime,video/x-matroska,video/x-flv,video/x-ms-wmv,video/x-m4v,audio/mpeg,audio/wav,audio/flac,audio/aac,audio/ogg,audio/x-ms-wma,image/png,image/jpeg,image/webp,image/gif,image/bmp,image/svg+xml,image/tiff,image/vnd.adobe.photoshop,application/postscript,image/x-raw,image/x-canon-crw,image/x-canon-cr2,image/x-nikon-nef,image/x-sony-arw
FILES_MEDIA_MAX_SIZE=1048576000

# Raw art files (PSD, AI, raw camera files)
FILES_RAW_ART_EXTENSIONS=psd,ai,xcf,raw,cr2,nef,arw,dng,eps,pdf
FILES_RAW_ART_MIMES=image/vnd.adobe.photoshop,application/postscript,image/x-xcf,image/x-raw,image/x-canon-crw,image/x-canon-cr2,image/x-nikon-nef,image/x-sony-arw,image/x-canon-dng,application/pdf
FILES_RAW_ART_MAX_SIZE=1048576000

# Generic documents (fallback)
FILES_DOCUMENT_EXTENSIONS=pdf,doc,docx,xls,xlsx,ppt,pptx,txt,rtf,odt,ods,odp
FILES_DOCUMENT_MIMES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,text/plain,application/rtf,application/vnd.oasis.opendocument.text,application/vnd.oasis.opendocument.spreadsheet,application/vnd.oasis.opendocument.presentation
FILES_DOCUMENT_MAX_SIZE=104857600

# =============================================================================
# IMAGE OPTIMIZATION CONFIGURATION (Phase 2.2)
# =============================================================================

# Maximum width for image resizing (px). Images wider will be resized proportionally.
ARCHIVE_IMAGE_MAX_WIDTH=2000

# WebP quality level (0-100). Recommended: 80 for balanced quality/size
ARCHIVE_IMAGE_WEBP_QUALITY=80

# Preserve EXIF metadata from original image during WebP conversion
ARCHIVE_IMAGE_PRESERVE_EXIF=false

# Vector formats that skip WebP conversion (comma-separated)
ARCHIVE_IMAGE_VECTOR_FORMATS=svg,pdf,eps,ai,emf,wmf

# =============================================================================
# ARCHIVE STORAGE CONFIGURATION
# =============================================================================

# Temporary directory for processing (relative to storage_path())
ARCHIVE_TEMP_DIR=app/temp/archive

# Storage disk name (configure in config/filesystems.php)
ARCHIVE_STORAGE_DISK=local_archives

# Base path within storage disk for archives
ARCHIVE_BASE_PATH=archivos

# =============================================================================
# ARCHIVE CLEANUP CONFIGURATION
# =============================================================================

# Enable automatic cleanup of orphaned temporary files
ARCHIVE_CLEANUP_ENABLED=true

# Age threshold for temporary file cleanup (minutes)
ARCHIVE_CLEANUP_TEMP_AGE_MINUTES=120

# Retention period for orphaned records before hard delete (days)
ARCHIVE_CLEANUP_ORPHANED_RETENTION_DAYS=30

# Maximum runtime for cleanup command (seconds)
ARCHIVE_CLEANUP_MAX_RUNTIME_SECONDS=300

# =============================================================================
# ARCHIVE VALIDATION CONFIGURATION
# =============================================================================

# Enable virus scanning (ClamAV integration - Phase 3+)
ARCHIVE_VIRUS_SCAN_ENABLED=false

# Validate file contents match extension/MIME type
ARCHIVE_CONTENT_VALIDATION_ENABLED=true

# =============================================================================
# ARCHIVE LOGGING CONFIGURATION
# =============================================================================

# Log channel for archive operations
ARCHIVE_LOG_CHANNEL=single

# Log every image optimization (verbose)
ARCHIVE_LOG_OPTIMIZATIONS=false

# Log every file upload (success/failure)
ARCHIVE_LOG_UPLOADS=true

VITE_APP_NAME="${APP_NAME}"

# =============================================================================
# SGEQ - SSO HACIA EL SISTEMA DE PRESTAMO DE EQUIPOS
# =============================================================================

# URL base de SGEQ (el backend Laravel, que es quien recibe el token)
SGEQ_URL=http://localhost:8000

# Deben coincidir exactamente con services.utamed_sso.issuer / .audience en SGEQ
SGEQ_SSO_ISSUER=utamed
SGEQ_SSO_AUDIENCE=sgeq

# Clave privada RSA con la que se firman los tokens. La publica correspondiente
# se copia a SGEQ. Generarlas con:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 \
#       -out storage/app/private/sso/sgeq-sso-private.pem
#   openssl rsa -pubout -in storage/app/private/sso/sgeq-sso-private.pem \
#       -out storage/app/private/sso/sgeq-sso-public.pem
# Por defecto ya apunta a storage/app/private/sso/sgeq-sso-private.pem;
# definir esta variable solo para usar otra ruta (absoluta).
# SGEQ_SSO_PRIVATE_KEY_PATH=

# Segundos de vigencia del token; solo tiene que alcanzar para el redirect
SGEQ_SSO_TTL=60

# IDs de administrativo.carrera cuyos estudiantes pueden abrir SGEQ (separados
# por coma). Vacio = ningun estudiante entra. Diseno Multimedia es la carrera 1
# en los datos sembrados; confirmar contra la BD del entorno.
SGEQ_SSO_CARRERAS=1
